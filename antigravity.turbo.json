{
  "$schema": "https://raw.githubusercontent.com/andyvandaric/opencode-ag-auth/main/assets/antigravity.schema.json",
  "quiet_mode": true,
  "debug": false,
  "auto_update": false,
  "session_recovery": true,
  "auto_resume": false,
  "account_selection_strategy": "round-robin",
  "scheduling_mode": "balance",
  "switch_on_first_rate_limit": true,
  "delete_account_on_403_tos": true,
  "max_cache_first_wait_seconds": 8,
  "max_rate_limit_wait_seconds": 90,
  "default_retry_after_seconds": 12,
  "max_backoff_seconds": 20,
  "request_jitter_max_ms": 150,
  "empty_response_max_attempts": 2,
  "empty_response_retry_delay_ms": 1200,
  "soft_quota_threshold_percent": 50,
  "quota_refresh_interval_minutes": 6,
  "soft_quota_cache_ttl_minutes": 12,
  "failure_ttl_seconds": 900,
  "health_score": {
    "initial": 65,
    "success_reward": 1,
    "rate_limit_penalty": -18,
    "failure_penalty": -28,
    "recovery_rate_per_hour": 3,
    "min_usable": 45,
    "max_score": 100
  },
  "token_bucket": {
    "max_tokens": 30,
    "regeneration_rate_per_minute": 4,
    "initial_tokens": 20
  }
}
