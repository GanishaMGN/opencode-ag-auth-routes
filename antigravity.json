{
  "$schema": "https://raw.githubusercontent.com/andyvandaric/opencode-ag-auth/main/assets/antigravity.schema.json",
  "quiet_mode": true,
  "debug": false,
  "auto_update": false,
  "session_recovery": true,
  "auto_resume": false,
  "account_selection_strategy": "round-robin",
  "scheduling_mode": "cache_first",
  "switch_on_first_rate_limit": true,
  "delete_account_on_403_tos": true,
  "max_cache_first_wait_seconds": 30,
  "max_rate_limit_wait_seconds": 60,
  "default_retry_after_seconds": 30,
  "max_backoff_seconds": 45,
  "request_jitter_max_ms": 800,
  "empty_response_max_attempts": 2,
  "empty_response_retry_delay_ms": 2000,
  "soft_quota_threshold_percent": 50,
  "quota_refresh_interval_minutes": 15,
  "soft_quota_cache_ttl_minutes": 30,
  "failure_ttl_seconds": 900,
  "health_score": {
    "initial": 80,
    "success_reward": 2,
    "rate_limit_penalty": -15,
    "failure_penalty": -20,
    "recovery_rate_per_hour": 3,
    "min_usable": 40,
    "max_score": 100
  },
  "token_bucket": {
    "max_tokens": 20,
    "regeneration_rate_per_minute": 3,
    "initial_tokens": 12
  }
}
