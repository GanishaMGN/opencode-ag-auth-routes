{
  "$schema": "https://raw.githubusercontent.com/andyvandaric/opencode-ag-auth/main/assets/antigravity.schema.json",
  "quiet_mode": true,
  "debug": false,
  "auto_update": false,
  "session_recovery": true,
  "auto_resume": false,
  "account_selection_strategy": "hybrid",
  "scheduling_mode": "cache_first",
  "switch_on_first_rate_limit": true,
  "delete_account_on_403_tos": true,
  "max_cache_first_wait_seconds": 20,
  "max_rate_limit_wait_seconds": 45,
  "default_retry_after_seconds": 20,
  "max_backoff_seconds": 30,
  "request_jitter_max_ms": 400,
  "empty_response_max_attempts": 1,
  "empty_response_retry_delay_ms": 1500,
  "soft_quota_threshold_percent": 65,
  "quota_refresh_interval_minutes": 10,
  "soft_quota_cache_ttl_minutes": 20,
  "failure_ttl_seconds": 600,
  "health_score": {
    "initial": 70,
    "success_reward": 1,
    "rate_limit_penalty": -25,
    "failure_penalty": -35,
    "recovery_rate_per_hour": 1,
    "min_usable": 55,
    "max_score": 100
  },
  "token_bucket": {
    "max_tokens": 15,
    "regeneration_rate_per_minute": 2,
    "initial_tokens": 8
  }
}
